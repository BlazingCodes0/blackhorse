{
  "comment": "Heart policy — machine-readable caps and hard bans. The referee. Nothing reaches the world without a Heart stamp.",

  "hard_bans": {
    "withdrawals": true,
    "move_funds_between_accounts": true,
    "market_orders_without_limit_price": false,
    "unknown_venue": true,
    "margin": true,
    "leverage": true,
    "borrowing": true,
    "interest": true,
    "derivatives": true,
    "futures": true,
    "short_selling": true,
    "perp_swaps": true
  },

  "spot_only": {
    "comment": "SPOT ONLY. Fully funded. No borrowed capital, ever.",
    "enforced": true,
    "max_leverage": 1.0,
    "allow_short": false,
    "allow_margin": false,
    "allow_futures": false,
    "allow_borrow": false,
    "allow_interest": false
  },

  "caps": {
    "max_position_pct": 25.0,
    "max_open_positions": 5,
    "max_daily_loss_pct": 3.0,
    "max_drawdown_pct": 10.0,
    "max_orders_per_hour": 12,
    "max_order_quote": 200.0
  },

  "deadman": {
    "heartbeat_max_age_seconds": 90,
    "on_miss": "PARK"
  },

  "graded_levels": {
    "L0_observe": "log only",
    "L1_soft": "pause the offending stream",
    "L2_halt": "stop all new money movement",
    "L3_lockdown": "freeze everything, wake human"
  },

  "autonomy_unlock": {
    "comment": "Autonomous trading may ARM only when ALL are true.",
    "require_credentials": true,
    "require_heart": true,
    "require_backtest_passed": true,
    "require_paper_period": true
  }
}
